# Same private token in the tournaments backend. Never use a VITE_ variable.
ANALYSIS_API_TOKEN=

# PostgreSQL is required for the local API/worker and in production.
# The API and process_analyses must use the same database configuration.
DB_NAME=backgammon_analysis
DB_USER=backgammon_analysis
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
